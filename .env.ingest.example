# Copia in .env.ingest e compila. Lo leggono SOLO gli script di ingestion (npm run ingest,
# npm run seed:examples). Su GitHub Actions gli stessi valori arrivano dai secrets.
# Non va mai in .env.local: OpenNext incorporerebbe le chiavi nel Worker.

# Supabase — SEGRETA (bypassa la RLS). Project Settings → API Keys → Secret keys
SUPABASE_SECRET_KEY=

# abuse.ch (ThreatFox + URLhaus): https://auth.abuse.ch/
ABUSECH_AUTH_KEY=
# AlienVault OTX (facoltativa): https://otx.alienvault.com/ → Settings
OTX_API_KEY=

# Anthropic (facoltativa): bozze «Difesa e aerospazio» e lettura del rapporto notturno scritte con IA.
# https://platform.claude.com → API keys. Imposta un limite di spesa. Senza chiave tutto funziona senza IA.
ANTHROPIC_API_KEY=
