{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "threatbrief",
  "main": ".open-next/worker.js",
  "upload_source_maps": true,
  "compatibility_date": "2026-11-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // Workers Cache: le risposte con Cloudflare-CDN-Cache-Control (solo pagine pubbliche, vedi
  // next.config.ts) vengono servite dalla cache senza eseguire il Worker (zero CPU).
  // Le pagine dell'analista hanno "private, no-store" e passano sempre dal Worker.
  "cache": { "enabled": true }
  // Nessuna chiave qui. NEXT_PUBLIC_SUPABASE_URL e NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
  // vengono incorporate al momento della build da .env.local (sono pubbliche per natura:
  // la protezione dei dati è la RLS). La chiave segreta non serve al Worker: la usano solo
  // gli script di ingestion su GitHub Actions.
}
